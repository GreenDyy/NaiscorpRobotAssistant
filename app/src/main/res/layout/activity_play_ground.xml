<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.playground.PlayGroundActivity">

    <!-- ScrollView cho các section test -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/logContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section: Test Status -->
            <LinearLayout
                android:id="@+id/sectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test Status Robot" />

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:flexWrap="wrap"
                    app:justifyContent="flex_start"
                    app:alignItems="flex_start"
                    app:alignContent="flex_start"
                    android:padding="4dp">

                    <Button
                        android:id="@+id/btnBatteryStatus"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check Battery Status"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnStatus2"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Get Nav Status"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnStatus3"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status 3"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnStatus4"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status 4"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnStatus5"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status 5"
                        android:layout_margin="4dp" />

                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>

            <!-- Section: Test Navigation -->
            <LinearLayout
                android:id="@+id/sectionNavigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test Navigation Robot" />

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:flexWrap="wrap"
                    app:flexDirection="row"
                    app:justifyContent="flex_start"
                    app:alignItems="flex_start"
                    app:alignContent="flex_start"
                    android:padding="4dp">

                    <EditText
                        android:id="@+id/etTargetId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Target ID"
                        android:layout_margin="4dp" />

                    <EditText
                        android:id="@+id/etApproximateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Approximate Time"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnNavStart"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nav Start"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnNavPause"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nav Pause"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnNavResume"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nav Resume"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnNavStop"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nav Stop"
                        android:layout_margin="4dp" />
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>

            <!-- Section: Test Head Motor -->
            <LinearLayout
                android:id="@+id/sectionHeadMotor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test Head Motor Robot" />

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:flexWrap="wrap"
                    app:justifyContent="flex_start"
                    app:alignItems="flex_start"
                    app:alignContent="flex_start"
                    android:padding="4dp">

                    <Button
                        android:id="@+id/btnHeadUp"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Up"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnHeadDown"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Down"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnHeadCenter"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Center"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnHeadLeft"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Left"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/btnHeadRight"
                        style="@style/ButtonOutlineSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Right"
                        android:layout_margin="4dp" />
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Log Container cố định ở dưới cùng -->
    <LinearLayout
        android:id="@+id/logContainer"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:background="@android:color/black"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header cho Log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Log Output"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Clear"
                android:textSize="12sp"
                android:backgroundTint="@android:color/darker_gray"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- ScrollView cho Log content -->
        <ScrollView
            android:id="@+id/scrollViewLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/black">

            <TextView
                android:id="@+id/tvLogOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log sẽ hiển thị ở đây...\n"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:padding="4dp" />

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
